# ---------------------------------------------------------------------------
# MiniLedger server - environment variables
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on (the mobile app points at http://<LAN-IP>:<PORT>)
PORT=4000

# Interface to bind. 0.0.0.0 makes the API reachable from a phone on the same Wi-Fi.
HOST=0.0.0.0

# PostgreSQL connection string.
DATABASE_URL=postgres://miniledger:miniledger_dev_pw@127.0.0.1:5432/miniledger

# Database used by the automated tests.
TEST_DATABASE_URL=postgres://miniledger:miniledger_dev_pw@127.0.0.1:5432/miniledger_test

# Safety override for the destructive test setup. Leave unset/false: tests
# refuse to run unless the target database name ends in "_test".
ALLOW_NON_TEST_DATABASE=false

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret-string

# How long an issued JWT stays valid (jsonwebtoken duration format).
JWT_EXPIRES_IN=7d

# Calendar timezone used to decide what "today" means for the overdue rule.
APP_TIMEZONE=Asia/Kolkata

# OTP challenge settings (mock OTP - no SMS provider is used).
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_SECONDS=900

# Development helpers. Never enable either of these in production.
# LOG_OTP_TO_CONSOLE prints the generated OTP to the server terminal.
LOG_OTP_TO_CONSOLE=true
# EXPOSE_OTP_IN_RESPONSE additionally returns the OTP in the API response.
EXPOSE_OTP_IN_RESPONSE=false

# Comma separated list of allowed origins, or * for any (mobile clients send no origin).
CORS_ORIGIN=*

# Set to "false" to silence request logging.
ENABLE_REQUEST_LOGGING=true
